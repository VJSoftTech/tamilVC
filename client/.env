# Client environment variables for production deployment
# IMPORTANT: Update these URLs to match your production server setup

# API server URL - This should be the full URL where your backend API is hosted
# Examples:
# - If API is on the same domain: https://yourdomain.com
# - If API is on a subdomain: https://api.yourdomain.com
# - If API is on a different port: https://yourdomain.com:5000
# Leave blank in development to use the local Vite proxy at /api
# In production, leave this blank if your app and API share the same origin.
# VITE_API_URL=/api

# Socket.IO server URL - Usually the same as API_URL
# If your Socket.IO server is on a different domain/port, set it here
# VITE_SOCKET_URL=https://your-socket-server-url